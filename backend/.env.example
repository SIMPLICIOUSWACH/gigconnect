SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=gigconnect
DB_USER=gigconnect
DB_PASSWORD=gigconnect
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where links in emails point. Use the real site address when deployed.
FRONTEND_URL=http://localhost:5173

# Email. Leave EMAIL_BACKEND out (or empty) to print emails to the console instead of sending them.
# For Gmail, use an app password, never the account password. See "Sending email" in the README.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gigconnect-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=GigConnect <your-gigconnect-address@gmail.com>
